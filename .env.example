# ─────────────────────────────────────────────────────────────
# Supabase 연결 설정 (예시 파일 — 값은 비어 있습니다)
#
# 이 파일은 "어떤 항목이 필요한지" 알려주는 견본이고,
# 실제 값은 .env.local 에 넣습니다. (.env.local 은 GitHub에 올라가지 않음)
#
# 값 찾는 곳: Supabase 대시보드 → 프로젝트 선택 → Settings → API
# ─────────────────────────────────────────────────────────────

# 프로젝트 URL (예: https://abcdefgh.supabase.co)
VITE_SUPABASE_URL=

# Publishable key (= anon public key). 브라우저에 공개되어도 되는 키입니다.
# ⚠️ service_role / secret key 는 절대 여기에 넣지 마세요.
VITE_SUPABASE_PUBLISHABLE_KEY=

# 작품 이미지가 저장된 Storage 버킷 이름 (예: works)
VITE_SUPABASE_STORAGE_BUCKET=
